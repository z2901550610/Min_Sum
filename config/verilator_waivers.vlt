`verilator_config

// Shared-compressor wrappers intentionally leave local-only status outputs open.
lint_off -rule PINCONNECTEMPTY -file "*rtl/hmac_sm3_64byte_key_stream.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/sm3_df_stream.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_decaps_postprocess_core.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_decaps_reencrypt_verify.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_decaps_syndrome_core.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_drng_weight_sampler.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_h4_error_sampler.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_h4_error_vector.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_encaps_core.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_keygen_secret_sampler.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_pseudohash512_stream.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_sm3_drng_generate_stream.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_sm3_drng_instantiate_stream.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_decaps_pipeline_core.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_decaps_runtime_synth_top.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_decaps_input_syndrome_core.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_encaps_synth_top.sv"
lint_off -rule PINCONNECTEMPTY -file "*rtl/trike_keygen_synth_top.sv"

// Local-compressor testbenches use the default non-shared implementation mode.
lint_off -rule PINMISSING -file "*tb/tb_hmac_sm3_64byte_key_stream.sv"
lint_off -rule PINMISSING -file "*tb/tb_sm3_df_stream.sv"
lint_off -rule PINMISSING -file "*tb/tb_sm3_hash_stream.sv"
lint_off -rule PINMISSING -file "*tb/tb_trike_pseudohash512_stream.sv"
lint_off -rule PINMISSING -file "*tb/tb_trike_sm3_drng_generate_stream.sv"
lint_off -rule PINMISSING -file "*tb/tb_trike_sm3_drng_instantiate_stream.sv"
lint_off -rule PINCONNECTEMPTY -file "*tb/tb_trike_pseudohash512_runtime.sv"
lint_off -rule PINCONNECTEMPTY -file "*tb/tb_trike_decaps_postprocess_runtime.sv"
lint_off -rule PINCONNECTEMPTY -file "*tb/tb_trike_keygen_core_reference.sv"
lint_off -rule PINCONNECTEMPTY -file "*tb/tb_trike_encaps_core_reference.sv"
lint_off -rule PINCONNECTEMPTY -file "*tb/tb_trike_decaps_syndrome_reference.sv"
lint_off -rule UNUSEDSIGNAL -file "*tb/tb_trike_decaps_syndrome_reference.sv"

// Focused local-multiplier testbenches use the default non-shared implementation mode.
lint_off -rule PINMISSING -file "*tb/tb_trike_encaps_uv_core.sv"
lint_off -rule PINMISSING -file "*tb/tb_trike_encaps_components_reference.sv"
lint_off -rule PINMISSING -file "*tb/tb_trike_keygen_arith_core.sv"
lint_off -rule PINMISSING -file "*tb/tb_trike_keygen_arith_reference.sv"
lint_off -rule PINMISSING -file "*tb/tb_trike_decaps_syndrome_runtime.sv"
lint_off -rule PINMISSING -file "*tb/tb_trike_decaps_syndrome_store_core.sv"
lint_off -rule PINMISSING -file "*tb/tb_trike_decaps_input_decoder_load_core.sv"

// Shared reference fixtures contain more golden fields than each focused test consumes.
lint_off -rule UNUSEDPARAM -file "*tb/generated/trike_keygen_reference_case.svh"
lint_off -rule UNUSEDPARAM -file "*tb/generated/trike_encaps_reference_case.svh"
lint_off -rule UNUSEDPARAM -file "*tb/generated/trike_decaps_message_minsum_case.svh"
lint_off -rule UNUSEDPARAM -file "*tb/generated/trike_decaps_syndrome_reference_case.svh"
lint_off -rule UNUSEDPARAM -file "*tb/generated/trike_poly_inv_reference_case.svh"
lint_off -rule UNUSEDPARAM -file "*tb/generated/trike_poly_inv_minsum_case.svh"
lint_off -rule UNUSEDPARAM -file "*tb/generated/trike_poly_mul_reference_case.svh"

// Public-parameter configurations deliberately leave inactive feature signals unused.
lint_off -rule UNUSEDSIGNAL -file "*rtl/decoder_top.sv"
lint_off -rule UNUSEDSIGNAL -file "*rtl/trike_decaps_pipeline_core.sv"
lint_off -rule UNUSEDSIGNAL -file "*rtl/trike_decaps_postprocess_core.sv"
lint_off -rule UNUSEDSIGNAL -file "*rtl/trike_decaps_syndrome_core.sv"
lint_off -rule UNUSEDSIGNAL -file "*rtl/trike_decaps_runtime_pipeline_core.sv"
lint_off -rule UNUSEDSIGNAL -file "*rtl/trike_decaps_unified_core.sv"
lint_off -rule UNUSEDSIGNAL -file "*rtl/trike_encaps_core.sv"
lint_off -rule UNUSEDSIGNAL -file "*rtl/trike_encaps_uv_core.sv"
lint_off -rule UNUSEDSIGNAL -file "*rtl/trike_keygen_arith_core.sv"
lint_off -rule UNUSEDSIGNAL -file "*rtl/trike_keygen_core.sv"

// Async-assert/sync-deassert reset structures are intentional in these files.
lint_off -rule SYNCASYNCNET -file "*rtl/reset_sync.sv"
lint_off -rule SYNCASYNCNET -file "*tb/tb_trike_decoder_load_adapter.sv"
lint_off -rule SYNCASYNCNET -file "*tb/tb_trike_decoder_load_adapter_runtime.sv"
