# Render with: d2 --layout dagre --pad 40 docs/decoder_datapath.d2 docs/decoder_datapath.svg
direction: right

classes: {
  signal: {
    style.fill: transparent
    style.stroke: transparent
    style.font-color: "#334155"
  }
  core: {
    style.fill: "#f8fafc"
    style.stroke: "#64748b"
  }
  stage: {
    style.fill: "#ffffff"
    style.stroke: "#cbd5e1"
  }
  ctrl: {
    style.fill: "#eef2ff"
    style.stroke: "#4f46e5"
  }
  mem: {
    style.fill: "#ecfdf5"
    style.stroke: "#059669"
  }
  pipe: {
    style.fill: "#fff7ed"
    style.stroke: "#ea580c"
  }
}

core: {
  label: "decoder_top 数据通路核心"
  class: core

  control: {
    label: "控制与地址"
    class: stage

    start: {
      label: "start"
      shape: text
      class: signal
    }

    h_load: {
      label: "H base_row_idx + diag_idx_local"
      shape: text
      class: signal
    }

    sched: {
      label: "tile_scheduler\n固定扫描\niter / tile / diag_idx_local / q_seq\nbuf 选择"
      class: ctrl
    }

    ram_i: {
      label: "ram_i\nH base_row_idx 存储\n输出 base_row_idx"
      class: mem
    }

    addr: {
      label: "edge_addr_gen\nC2V / V2C 地址\nrow_addr / tile_offset / diag_idx_global"
      class: ctrl
    }

    o_done: {
      label: "o_done / o_iter_count"
      shape: text
      class: signal
    }
  }

  c2v: {
    label: "C2V"
    class: stage

    syndrome_in: {
      label: "syndrome 写入"
      shape: text
      class: signal
    }

    state_read: {
      label: "状态读取\nram_m / ram_s / ram_syndrome\ncomp / sign / s[row]"
      class: mem
    }

    cnu_b: {
      label: "CNU B\n重建 C2V 消息"
      class: pipe
    }

    to_raw: {
      label: "sign-mag -> c2v_tc"
      class: pipe
    }
  }

  tilebuf: {
    label: "tile 双缓冲"
    class: stage

    accum: {
      label: "ram_accum\n累加 c2v_sum"
      class: mem
    }

    edge: {
      label: "ram_t\n保存 c2v_edge"
      class: mem
    }
  }

  v2c: {
    label: "V2C 与写回"
    class: stage

    vnu: {
      label: "vnu\nc2v_sum + c2v_edge\n生成 posterior / V2C"
      class: pipe
    }

    cnu_a: {
      label: "CNU A\n更新压缩校验状态"
      class: pipe
    }

    state_write: {
      label: "状态写回\nram_m / ram_s\nupdated comp / sign\n供后续 C2V 读取"
      class: mem
    }
  }

  decision: {
    label: "判决输出"
    class: stage

    e_read_col_idx: {
      label: "i_e_read_col_idx"
      shape: text
      class: signal
    }

    ram_decision: {
      label: "ram_decision\nfinal_iter posterior sign\n错误估计 bit"
      class: mem
    }

    o_e_rdata: {
      label: "o_e_rdata"
      shape: text
      class: signal
    }
  }
}

core.control.start -> core.control.sched
core.control.h_load -> core.control.ram_i: "写 H"
core.control.sched -> core.control.ram_i: "h_block / diag_idx_local"
core.control.sched -> core.control.addr: "phase / h_block / diag_idx_local / tile / q_seq"
core.control.ram_i -> core.control.addr: "base_row_idx"
core.control.sched -> core.control.o_done

core.control.addr -> core.c2v.state_read: "C2V row / diag_idx_global"
core.c2v.syndrome_in -> core.c2v.state_read: "写 syndrome"
core.c2v.state_read -> core.c2v.cnu_b: "comp / sign / syndrome"
core.c2v.cnu_b -> core.c2v.to_raw: "C2V"
core.c2v.to_raw -> core.tilebuf.accum: "c2v_tc 累加"
core.c2v.to_raw -> core.tilebuf.edge: "c2v_tc 保存"

core.control.addr -> core.v2c.vnu: "V2C tile_offset / diag_idx_global"
core.tilebuf.accum -> core.v2c.vnu: "c2v_sum"
core.tilebuf.edge -> core.v2c.vnu: "c2v_edge"
core.v2c.vnu -> core.v2c.cnu_a: "V2C message"
core.v2c.cnu_a -> core.v2c.state_write: "updated comp / sign"

core.v2c.vnu -> core.decision.ram_decision: "posterior sign"
core.decision.e_read_col_idx -> core.decision.ram_decision: "读列"
core.decision.ram_decision -> core.decision.o_e_rdata
